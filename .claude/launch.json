{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kongbu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "design-docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/design"
      ],
      "port": 4173
    },
    {
      "name": "kongbu-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4175",
        "--strictPort"
      ],
      "port": 4175
    }
  ]
}
