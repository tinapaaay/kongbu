{
  "name": "kongbu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "tokens": "design.md export DESIGN.md --format css-vars > src/styles/tokens.css",
    "design:lint": "design.md lint DESIGN.md",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run design:lint && npm run design:check-type && npm run build && npm run check:content-split && npm run check:secrets && npm run test:e2e",
    "design:check-type": "node scripts/check-type-scale.mjs",
    "check:content-split": "node scripts/check-content-split.mjs"
  },
  "dependencies": {
    "@fontsource/titillium-web": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.1"
  }
}
